# Ambiente e Porta
NODE_ENV=production
PORT=3001

# Google Gemini AI (Copilot)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase (Banco de Dados e Auth)
SUPABASE_URL=https://lxucntgxipmpjjdlkgmi.supabase.co
SUPABASE_ANON_KEY=sua_chave_anonima_supabase_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_supabase_aqui

# CORS: Domínios permitidos separados por vírgula (subdomínios .vercel.app já são aceitos automaticamente)
ALLOWED_ORIGINS=https://seu-app.vercel.app,http://localhost:5173

# Web Push Notifications (Gere um par fixo com 'npx web-push generate-vapid-keys' para não resetar a cada reboot)
VAPID_PUBLIC_KEY=sua_chave_publica_vapid
VAPID_PRIVATE_KEY=sua_chave_privada_vapid
VAPID_SUBJECT=mailto:suporte@seudominio.com.br

# Fallback da Empresa Padrão (Opcional)
DEFAULT_COMPANY_ID=empresa-piloto-001
